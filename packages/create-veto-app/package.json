{
  "name": "create-veto-app",
  "version": "0.2.6",
  "description": "Scaffold a minimal Veto TypeScript agent project",
  "type": "module",
  "bin": {
    "create-veto-app": "./dist/bin.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
