    "test": "vitest run",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "veto-sdk": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "typescript": "^5.3.0",
    "vitest": "^4.0.16"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "license": "Apache-2.0"
}
