{
  "name": "veto-sdk",
  "version": "2.12.1",
  "description": "Policy runtime for AI agent tool calls",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "bin": {
    "veto": "./dist/cli/bin.js",
    "veto-mcp-proxy": "./dist/cli/mcp-proxy-bin.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "lint": "eslint src --ext .ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "audit:docker": "bash scripts/docker-audit.sh",
    "benchmark": "node dist/benchmark/cli.js",
    "benchmark:dev": "tsx src/benchmark/cli.ts",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "ai",
    "agent",
    "policy-runtime",
    "tool-calls",
    "runtime-governance",
    "authorization",
    "llm",
    "openai",
    "anthropic",
    "gemini",
    "vercel-ai",
    "langchain",
    "langgraph"
  ],
  "author": "",
  "license": "Apache-2.0",
  "devDependencies": {
    "@opentelemetry/api": "^1.9.1",
    "@types/node": "^20.10.0",
    "@types/react": "^18.3.26",
    "@vitest/coverage-v8": "^4.0.16",
    "ink": "^5.0.0",
    "openai": "^4.77.0",
    "tsx": "^4.7.0",
    "typescript": "^5.3.0",
    "vitest": "^4.0.16",
    "zod": "^3.22.0"
  },
  "peerDependencies": {
    "@anthropic-ai/sdk": "^0.20.0",
    "@google/genai": "^1.34.0",
    "@langchain/core": ">=0.2.0",
    "@opentelemetry/api": ">=1.0.0",
    "@opentui/core": "^0.1.0",
    "ai": ">=3.0.0",
    "ink": "^5.0.0",
    "openai": "^4.0.0",
    "react": "^18.0.0",
    "redis": "^4.0.0",
    "zod": "^3.22.0"
  },
  "peerDependenciesMeta": {
    "@opentelemetry/api": {
      "optional": true
    },
    "openai": {
      "optional": true
    },
    "@anthropic-ai/sdk": {
      "optional": true
    },
    "@google/genai": {
      "optional": true
    },
    "redis": {
      "optional": true
    },
    "zod": {
      "optional": true
    },
    "ai": {
      "optional": true
    },
    "@langchain/core": {
      "optional": true
    },
    "ink": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "@opentui/core": {
      "optional": true
    }
  },
  "dependencies": {
    "ajv": "^8.18.0",
    "picocolors": "^1.1.1",
    "veto-receipt-protocol": "workspace:*",
    "yaml": "^2.8.2"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "files": [
    "dist",
    "packs",
    "README.md"
  ],
  "exports": {
    ".": {
      "browser": {
        "types": "./dist/browser/index.d.ts",
        "import": "./dist/browser/index.js"
      },
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./browser": {
