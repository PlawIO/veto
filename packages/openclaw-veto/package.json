{
  "name": "openclaw-veto",
  "version": "0.2.10",
  "description": "Veto policy runtime plugin for OpenClaw — intercept, validate, and control every agent tool call",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "openclaw.plugin.json"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "vitest run",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "openclaw",
    "openclaw-plugin",
    "veto",
    "policy-runtime",
    "tool-calls",
    "runtime-governance",
    "agent-authorization"
  ],
  "openclaw": {
    "extensions": [
      "./dist/index.js"
    ],
    "compat": {
      "pluginApi": ">=2026.3.24-beta.2"
    }
  },
  "dependencies": {
    "veto-sdk": "workspace:*"
  },
  "peerDependencies": {
    "openclaw": ">=2026.3.0"
  },
  "peerDependenciesMeta": {
    "openclaw": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "typescript": "^5.3.0",
    "vitest": "^3.0.0"
  },
  "license": "Apache-2.0"
}
