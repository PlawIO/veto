{
  "name": "veto-spend-capsule-protocol",
  "version": "0.2.0",
  "description": "Signed, short-lived, single-use authority objects for agentic money movement. Protocol spec + reference verifier.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./schema/spend-capsule": "./src/schema/spend-capsule.schema.json",
    "./schema/decision-receipt": "./src/schema/decision-receipt.schema.json"
  },
  "files": [
    "dist",
    "src/schema"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "lint": "eslint src --ext .ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "fixture:gen": "node scripts/gen-contract-fixture.mjs > ../sdk-python/tests/fixtures/contract-capsule.json",
    "fixture:check": "node scripts/check-contract-fixture.mjs",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "veto",
    "spend-capsule",
    "delegated-authority",
    "ai-agent",
    "agentic-payments",
    "merkle",
    "jws",
    "ed25519",
    "jcs",
    "audit"
  ],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/PlawIO/veto",
    "directory": "packages/spend-capsule-protocol"
  },
  "homepage": "https://docs.veto.so/meow",
  "dependencies": {
    "@noble/ed25519": "^2.3.0",
    "@noble/hashes": "^1.5.0",
    "@scure/base": "^1.1.9",
    "canonicalize": "^2.1.0",
    "jose": "^5.9.6",
    "veto-receipt-protocol": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@vitest/coverage-v8": "^4.0.16",
    "typescript": "^5.3.0",
    "vitest": "^4.0.16"
  }
}
