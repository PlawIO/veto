{
  "name": "veto-bash",
  "version": "0.1.0",
  "description": "Rust-first guarded bash runtime with MCP support",
  "type": "module",
  "bin": {
    "veto-bash": "./dist/bin.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "node ./scripts/build.mjs",
    "dev": "tsc --watch",
    "lint": "eslint src scripts --ext .ts,.mjs",
    "test": "cargo test --manifest-path ../../crates/veto-bash/Cargo.toml"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "typescript": "^5.3.0"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT"
}
