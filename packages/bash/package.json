{
  "name": "veto-bash",
  "version": "0.2.1",
  "description": "Rust-first policy runtime for bash tool calls with MCP support",
  "type": "module",
  "bin": {
    "veto-bash": "./dist/bin.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/PlawIO/veto",
    "directory": "packages/bash"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "node ./scripts/build.mjs",
    "dev": "tsc --watch",
    "lint": "eslint src scripts --ext .ts,.mjs",
    "test": "cargo test --manifest-path ../../crates/veto-bash/Cargo.toml",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "typescript": "^5.3.0"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "Apache-2.0"
}
