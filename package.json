{
  "name": "veto-monorepo",
  "private": true,
  "description": "The permission layer for AI agents",
  "repository": {
    "type": "git",
    "url": "https://github.com/PlawIO/veto"
  },
  "scripts": {
    "build": "turbo build --filter='./packages/*'",
    "test": "turbo test --filter='./packages/*'",
    "typecheck": "turbo typecheck --filter='./packages/*'",
    "lint": "turbo lint --filter='./packages/*'",
    "dev:cli": "pnpm --filter veto-cli dev",
    "dev:sdk": "pnpm --filter veto-sdk dev",
    "dev:web": "pnpm --filter @veto/web dev",
    "build:cli": "pnpm --filter veto-cli build",
    "build:sdk": "pnpm --filter veto-sdk build",
    "build:web": "pnpm --filter @veto/web build",
    "check:dependency-zones": "node scripts/check-dependency-zones.mjs",
    "smoke:ts-base-no-deps": "node scripts/smoke-ts-base-no-deps.mjs",
    "smoke:python-base-no-deps": "python3 scripts/smoke-python-base-no-deps.py",
    "smoke:finance-demo": "node scripts/smoke-finance-demo.mjs",
    "test:core": "cargo test --manifest-path crates/veto-core/Cargo.toml",
    "changeset": "changeset",
    "version": "node scripts/version.mjs",
    "release": "pnpm build && changeset publish",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx}": "eslint --fix",
    "*.{json,md,yml,yaml}": "prettier --write --ignore-unknown",
    "packages/sdk-python/**/*.py": "ruff check --fix"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^0.5.2",
    "@changesets/cli": "^2.29.8",
    "@eslint/js": "^9.39.2",
    "eslint": "^9.39.2",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "turbo": "^2.7.3",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.52.0"
  },
  "engines": {
    "node": ">=20",
    "pnpm": ">=9"
  },
  "pnpm": {
    "overrides": {
      "axios@<1.15.0": "1.15.0",
      "minimatch@<3.1.4": "3.1.4",
      "minimatch@>=9.0.0 <9.0.7": "9.0.7",
      "picomatch@<2.3.2": "2.3.2",
      "picomatch@>=4.0.0 <4.0.4": "4.0.4",
      "flatted@<3.4.2": "3.4.2",
      "brace-expansion@<2.0.3": "2.0.3",
      "rollup@>=4.0.0 <4.59.0": "4.59.0",
      "yaml@>=2.0.0 <2.8.3": "2.8.3",
      "diff@>=6.0.0 <8.0.3": "8.0.3",
      "ajv@>=6.0.0 <6.14.0": "6.14.0",
      "@langchain/core@<0.3.80": "0.3.80",
      "file-type@>=13.0.0 <21.3.2": "21.3.2",
      "langsmith@<0.4.6": "0.4.6"
    }
  },
  "packageManager": "pnpm@9.15.0",
  "license": "Apache-2.0",
  "author": "Plaw, Inc.",
  "homepage": "https://veto.run"
}
